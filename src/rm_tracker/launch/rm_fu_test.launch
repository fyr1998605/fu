<launch>
    <!-- 识别器测试: 相机 + 串口 + BuffRecognizer(只识别,不跑预测/PnP) -->
    <arg name="buff_model_path" default="$(find rm_tracker)/../../Model/fu_moxi/buff_repvgg.xml" />
    <arg name="enemy_color"     default="blue" />

    <!-- 相机 -->
    <include file="$(find rm_hikcamera)/launch/rm_hikcamera.launch"/>

    <!-- 串口 (写死打符模式) -->
    <include file="$(find rm_serial)/launch/rm_serial.launch">
        <arg name="shootflag" value="f" />
    </include>

    <!-- 识别器 -->
    <node pkg="rm_tracker" type="buff_test" name="buff_test" respawn="true" output="screen">
        <param name="buff_model_path" value="$(arg buff_model_path)" />
        <param name="enemy_color"     value="$(arg enemy_color)" />
    </node>
</launch>
