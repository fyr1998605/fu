<launch>
    <arg name="r_model_path" default="Model/fu_moxi/R_best.onnx" />
    <arg name="fan_model_path" default="Model/fu_moxi/Fan_best.onnx" />
    <arg name="buff_model_path" default="Model/fu_moxi/buff_repvgg.xml" />
    <arg name="fu_config" default="$(find rm_tracker)/config/rm_fu.yaml" />

    <node pkg="rm_tracker" type="Fu" name="Fu" respawn="true" output="screen">
        <param name="r_model_path" value="$(arg r_model_path)" />
        <param name="fan_model_path" value="$(arg fan_model_path)" />
        <param name="buff_model_path" value="$(arg buff_model_path)" />
        <param name="fu_config_path" value="$(arg fu_config)" />
        <rosparam file="$(arg fu_config)" command="load" />
    </node>
</launch>
