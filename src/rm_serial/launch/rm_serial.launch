<launch>
    <!-- 打符模式写死: 电控没有按f切换能量机关的逻辑, 默认 'f' (能量机关) -->
    <!-- 需要调试装甲板时改为 'a' -->
    <arg name="shootflag"  default="f" />
    <arg name="bullet_vec" default="21.0" />

    <node name="serial" pkg="rm_serial" type="rm_serial_node" output="screen" respawn="true">
        <param name="armor_serial_config"
               type="string"
               value="$(find rm_serial)/config/rm_serial.yaml" />

        <param name="shootflag"  value="$(arg shootflag)" />
        <param name="bullet_vec" value="$(arg bullet_vec)" />
    </node>
</launch>
