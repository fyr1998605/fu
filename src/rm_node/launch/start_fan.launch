<launch>
    <arg name="fu_config" default="$(find rm_tracker)/config/rm_fu.yaml" />
    <arg name="shootflag_test" default="f" />
    <arg name="camp_test" default="r" />
    <arg name="sim_mode" default="false" />

    <!-- ================================================
         打符模式 (能量机关)
         运行: roslaunch rm_node start_fan.launch
         节点: 相机 + 串口 + Fu(YOLO检测+预测+PnP)
         不启动: identify (灯条检测) / tracker (装甲跟踪)
    ================================================ -->
    <rosparam file="$(find rm_node)/config/camera.yaml" command="load"/>

    <include file="$(find rm_hikcamera)/launch/rm_hikcamera.launch"/>
    <include file="$(find rm_serial)/launch/rm_serial.launch">
        <arg name="shootflag_test" value="$(arg shootflag_test)" />
        <arg name="camp_test" value="$(arg camp_test)" />
        <arg name="sim_mode" value="$(arg sim_mode)" />
    </include>
    <include file="$(find rm_tracker)/launch/rm_fu.launch">
        <arg name="r_model_path"    value="$(find rm_tracker)/../../Model/fu_moxi/R_best.onnx" />
        <arg name="fan_model_path"  value="$(find rm_tracker)/../../Model/fu_moxi/Fan_best.onnx" />
        <arg name="buff_model_path" value="$(find rm_tracker)/../../Model/fu_moxi/buff_repvgg.xml" />
        <arg name="fu_config" value="$(arg fu_config)" />
    </include>

    <!-- 可选: rviz 可视化 -->
    <!-- <node pkg="rviz" type="rviz" name="rviz" args="-d $(find rm_node)/config/vision.rviz" /> -->
</launch>
