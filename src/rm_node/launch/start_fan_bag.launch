<launch>
    <arg name="fu_config" default="$(find rm_tracker)/config/rm_fu.yaml" />
    <arg name="bag_file" default="/home/fyr/2025-12-16-20-21-09_fu.bag" />
    <arg name="bag_speed" default="1.0" />
    <arg name="bag_start_paused" default="false" />
    <!-- 循环播放: bag 只有 4.4s, 默认循环让图像持续显示 (只播一遍传 bag_loop:="") -->
    <arg name="bag_loop" default="--loop" />

    <!-- 加载相机参数 (Fu节点需要相机内参) -->
    <rosparam file="$(find rm_node)/config/camera.yaml" command="load"/>

    <!-- Fu 节点 (YOLO检测 + 预测 + PnP) -->
    <include file="$(find rm_tracker)/launch/rm_fu.launch">
        <arg name="r_model_path"    value="$(find rm_tracker)/../../Model/fu_moxi/R_best.onnx" />
        <arg name="fan_model_path"  value="$(find rm_tracker)/../../Model/fu_moxi/Fan_best.onnx" />
        <arg name="buff_model_path" value="$(find rm_tracker)/../../Model/fu_moxi/buff_repvgg.xml" />
        <arg name="fu_config" value="$(arg fu_config)" />
    </include>

    <!-- 播放 bag 包, 代替实时相机和串口 -->
    <node if="$(arg bag_start_paused)" pkg="rosbag" type="play" name="rosbag_play"
          args="$(arg bag_file) -r $(arg bag_speed) --pause $(arg bag_loop)">
    </node>
    <node unless="$(arg bag_start_paused)" pkg="rosbag" type="play" name="rosbag_play"
          args="$(arg bag_file) -r $(arg bag_speed) $(arg bag_loop)">
    </node>
</launch>